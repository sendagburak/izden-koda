; İzden Koda - Godot 4.7.2 stable
config_version=5

[application]
config/name="İzden Koda"
config/version="0.8.1"
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/ALGORİTMA OYUNU"
config/quit_on_go_back=false
config/description="Çevrimdışı, yedi dünyalı algoritma öğrenme macerası"
config/icon="res://varliklar/ui/icon.png"
run/main_scene="res://oyun/app/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=true
boot_splash/image="res://varliklar/ui/icon.png"
boot_splash/use_filter=false
boot_splash/bg_color=Color(0.025, 0.10, 0.14, 1)

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_2d=0
environment/defaults/default_clear_color=Color(0.06, 0.13, 0.16, 1)

[physics]
common/physics_ticks_per_second=30

[gui]
theme/default_font_size=19
